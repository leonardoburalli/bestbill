            "type": "number"
          },
          "total": {
            "title": "Total",
            "type": "number"
          }
        },
        "required": [
          "energy",
          "fixed_fees",
          "per_kwh_extras",
          "power_fee",
          "dispatching",
          "one_off",
          "discounts",
          "total"
