            "title": "Consumption To Kwh"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "duration_months": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Months"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "unit": {
            "$ref": "#/components/schemas/DiscountUnit"
          },
          "validity": {
            "$ref": "#/components/schemas/DiscountValidity"
          }
        },
        "required": [
          "name",
          "validity",
          "conditional",
          "amount",
          "unit"
        ],
        "title": "Discount",
        "type": "object"
      },
