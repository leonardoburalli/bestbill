        "title": "Assumptions",
        "type": "object"
      },
      "BandStructure": {
        "description": "How an offer's energy price is split across bands.",
        "enum": [
          "mono",
          "f1f2f3",
          "f1f23"
        ],
        "title": "BandStructure",
        "type": "string"
      },
      "BreakEvenStatus": {
        "description": "Classifies a variable offer's break-even PUN against the cheapest\neligible fixed offer (see ``bestbill.core.calculator._break_even_pun``):\n\n- ``CHEAPER_BELOW``: the normal case -- the variable offer is cheaper\n  than the best fixed offer for PUN values below the break-even point\n  (and more expensive above it).\n- ``NEVER_CHEAPER``: the break-even PUN is <= 0 -- the variable offer\n  is never cheaper than the best fixed offer at any non-negative PUN.\n- ``ALWAYS_CHEAPER``: the variable offer's cost slope (kWh × loss\n  multiplier) is <= 0, so it can't be compared as a break-even point;\n  in practice this only happens when there's no fixed offer to break\n  even against or the variable offer has zero/negative consumption\n  exposure -- kept for completeness, see the calculator docstring.",
        "enum": [
          "cheaper_below",
          "never_cheaper",
          "always_cheaper"
        ],
        "title": "BreakEvenStatus",
        "type": "string"
      },
      "CatalogCounts": {
