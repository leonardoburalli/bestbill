      "ResultItem": {
        "description": "One ranked offer. ``cost_eur`` is the commodity/retailer cost only,\nbefore VAT (see ``assumptions.cost_label``); ``rank`` and\n``delta_vs_best_eur`` are within the filtered list (never changed by\n``search``).",
        "properties": {
          "band_structure": {
            "$ref": "#/components/schemas/BandStructure"
          },
          "break_even_pun_eur_kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Break Even Pun Eur Kwh"
          },
          "break_even_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BreakEvenStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "breakdown": {
            "$ref": "#/components/schemas/CostBreakdown"
          },
          "conditional_discounts": {
            "items": {
              "$ref": "#/components/schemas/Discount"
            },
            "title": "Conditional Discounts",
            "type": "array"
          },
          "cost_eur": {
            "title": "Cost Eur",
            "type": "number"
          },
          "delta_vs_best_eur": {
            "title": "Delta Vs Best Eur",
            "type": "number"
          },
          "duration_months": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Months the economic conditions are guaranteed; null when open-ended or unknown.",
            "title": "Duration Months"
          },
          "duration_open_ended": {
            "default": false,
            "description": "True for offers with no fixed term.",
            "title": "Duration Open Ended",
            "type": "boolean"
          },
          "energy_discount_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "(1 - after/listed) x 100, 1 decimal; null when no discount applies.",
            "title": "Energy Discount Pct"
          },
          "energy_price_after_discounts_eur_kwh": {
            "description": "energy_price_eur_kwh after unconditional percent and EUR/kWh energy discounts (variable offers: spread only). Fixed EUR/year, one-off and conditional discounts are not included.",
            "title": "Energy Price After Discounts Eur Kwh",
            "type": "number"
          },
          "energy_price_eur_kwh": {
            "description": "Advertised unit energy price (EUR/kWh, ex VAT): weighted listed price (fixed) or spread over PUN (pun_spread); excludes discounts, fixed fees, extras, dispatching, power fee and losses.",
            "title": "Energy Price Eur Kwh",
            "type": "number"
          },
          "energy_price_kind": {
            "enum": [
              "fixed",
              "pun_spread"
            ],
            "title": "Energy Price Kind",
            "type": "string"
          },
          "eur_per_kwh_effective": {
            "title": "Eur Per Kwh Effective",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "offer_id": {
            "title": "Offer Id",
            "type": "string"
          },
          "one_off_fee_eur": {
            "title": "One Off Fee Eur",
            "type": "number"
          },
          "price_type": {
            "$ref": "#/components/schemas/PriceType"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/OfferSource"
          },
          "supplier": {
            "title": "Supplier",
            "type": "string"
          },
          "supplier_name_source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SupplierNameSource"
              },
              {
                "type": "null"
              }
            ]
          },
          "supplier_vat": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier Vat"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "valid_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid From"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "required": [
          "offer_id",
          "rank",
          "supplier",
          "name",
          "supplier_vat",
          "supplier_name_source",
          "url",
          "source",
          "price_type",
          "band_structure",
          "valid_from",
          "valid_to",
          "cost_eur",
          "delta_vs_best_eur",
          "eur_per_kwh_effective",
          "energy_price_eur_kwh",
          "energy_price_kind",
          "energy_price_after_discounts_eur_kwh",
          "energy_discount_pct",
          "breakdown",
          "break_even_pun_eur_kwh",
          "break_even_status",
          "one_off_fee_eur",
          "conditional_discounts"
        ],
        "title": "ResultItem",
        "type": "object"
      },
      "SampleHousehold": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "months": {
            "items": {
              "$ref": "#/components/schemas/SampleMonth"
            },
            "title": "Months",
            "type": "array"
          }
        },
        "required": [
          "location",
          "description",
          "months"
        ],
        "title": "SampleHousehold",
        "type": "object"
      },
      "SampleMonth": {
        "description": "One month of consumption, in the same shape `/api/compare` accepts.\n\nNo PUN: the API always prices variable offers with ARERA's monthly PUN\nfrom the catalogue, never a user-supplied one.",
        "properties": {
          "kwh": {
            "title": "Kwh",
            "type": "number"
          },
          "month": {
            "examples": [
              "2025-09"
            ],
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "month",
          "kwh"
        ],
        "title": "SampleMonth",
        "type": "object"
      },
      "Scaled": {
        "additionalProperties": false,
        "description": "Multiply every historical PUN value by a factor (e.g. 1.2 = +20%).",
        "properties": {
          "factor": {
            "exclusiveMinimum": 0.0,
            "title": "Factor",
            "type": "number"
          },
          "kind": {
            "const": "scaled",
            "default": "scaled",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "factor"
        ],
        "title": "Scaled",
        "type": "object"
      },
      "SupplierNameSource": {
        "description": "Where an offer's ``supplier`` display name came from, in resolution\norder (see ``bestbill.arera.operators`` and ``bestbill.catalog.build``):\n\n- ``ARERA``: the ARERA \"Ricerca operatori\" export (RAGIONE SOCIALE),\n  matched by VAT (PARTITA IVA).\n- ``PLACET``: a PLACET row's ``denominazione`` for the same VAT\n  (mercato libero offers only -- PLACET offers always use ``ARERA``\n  or their own ``denominazione`` directly is treated as ``PLACET``).\n- ``DOMAIN``: the retailer's website domain, from\n  ``URL_SITO_VENDITORE``, stripped of scheme/``www.``/path.\n- ``VAT``: last resort, ``\"P.IVA <vat>\"``.",
        "enum": [
          "arera",
          "placet",
          "domain",
          "vat"
        ],
        "title": "SupplierNameSource",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationErrorResponse": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ValidationErrorResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Stateless API: consumption is processed in memory per request and never stored or logged. Every cost is the commodity/retailer cost only, before VAT ('costo materia energia (IVA esclusa)'), and a backtest ('perfect foresight'): the same kWh and the same monthly PUN as your last 12 months. It is not a forecast.",
    "title": "BestBill API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog/meta": {
      "get": {
        "operationId": "catalog_meta_api_catalog_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogMeta"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Catalogue not loaded yet."
          }
        },
        "summary": "Catalog Meta"
      }
    },
    "/api/compare": {
      "post": {
        "description": "Backtest (\"perfect foresight\"): what today's offers would have cost on\nyour last 12 months of consumption and PUN. Commodity/retailer cost only,\nbefore VAT. Not a forecast.",
        "operationId": "compare_offers_api_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body over 64 KB."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Catalogue not loaded yet."
          }
        },
        "summary": "Compare Offers"
      }
    },
    "/api/comuni": {
      "get": {
        "operationId": "comuni_api_comuni_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 60,
              "minLength": 2,
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ComuneOut"
                  },
                  "title": "Response Comuni Api Comuni Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Comuni"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/offers": {
      "get": {
        "operationId": "list_offers_api_offers_get",
        "parameters": [
          {
            "in": "query",
            "name": "price_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PriceType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price Type"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/OfferSource"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "in": "query",
            "name": "supplier",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Supplier"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Catalogue not loaded yet."
          }
        },
        "summary": "List Offers"
      }
    },
    "/api/sample": {
      "get": {
        "operationId": "sample_api_sample_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleHousehold"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sample"
      }
    }
  }
}
