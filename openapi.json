                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Istat Comune"
          },
          "period_end": {
            "format": "date",
            "title": "Period End",
            "type": "string"
          },
          "period_start": {
            "format": "date",
            "title": "Period Start",
            "type": "string"
          },
          "pun_months_used": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "format": "date"
            },
            "title": "Pun Months Used",
            "type": "object"
          },
          "residency": {
            "default": "resident",
            "enum": [
              "resident",
              "non_resident"
            ],
            "title": "Residency",
            "type": "string"
          },
          "scenario": {
            "discriminator": {
              "mapping": {
                "flat": "#/components/schemas/Flat",
                "historical": "#/components/schemas/Historical",
                "scaled": "#/components/schemas/Scaled"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/Historical"
              },
              {
                "$ref": "#/components/schemas/Scaled"
              },
              {
                "$ref": "#/components/schemas/Flat"
              }
            ],
            "title": "Scenario"
          },
          "statement": {
            "title": "Statement",
            "type": "string"
          },
          "substituted_pun_months": {
            "items": {
              "format": "date",
              "type": "string"
            },
            "title": "Substituted Pun Months",
            "type": "array"
          }
        },
        "required": [
          "period_start",
          "period_end",
          "pun_months_used",
          "substituted_pun_months",
          "band_split_source",
          "scenario",
          "statement"
