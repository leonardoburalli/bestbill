              "type": "integer"
            },
            "title": "Excluded By Reason",
            "type": "object"
          },
          "included": {
            "title": "Included",
            "type": "integer"
          },
          "included_by_source": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Included By Source",
            "type": "object"
          }
