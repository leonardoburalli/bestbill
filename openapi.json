      "Discount": {
        "additionalProperties": false,
        "description": "A commercial discount (Sconto). Unconditional first-12-month\ndiscounts are priced into the estimate by the engine (see\n``bestbill.arera.policy``); conditional discounts are kept for display\nonly.",
