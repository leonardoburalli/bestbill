      "CompareFilters": {
        "additionalProperties": false,
        "properties": {
          "max_duration_months": {
            "anyOf": [
              {
                "maximum": 120.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Keep only offers whose economic conditions are guaranteed for at most this many months (combine with min_duration_months for an exact duration). Open-ended and unknown-duration offers are EXCLUDED.",
            "title": "Max Duration Months"
          },
          "min_duration_months": {
            "anyOf": [
              {
                "maximum": 120.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Keep only offers whose economic conditions are guaranteed for at least this many months. Open-ended (indeterminata) and unknown-duration offers are EXCLUDED, since they do not guarantee the conditions for a fixed period.",
            "title": "Min Duration Months"
          },
          "price_type": {
