          }
        },
        "title": "CompareFilters",
        "type": "object"
      },
      "CompareRequest": {
        "additionalProperties": false,
        "description": "12 consecutive months of household consumption. Processed in memory\nand never stored or logged.",
        "properties": {
          "committed_power_kw": {
            "default": 3.0,
            "exclusiveMinimum": 0.0,
            "maximum": 30.0,
            "title": "Committed Power Kw",
            "type": "number"
          },
          "consumption": {
            "items": {
              "$ref": "#/components/schemas/MonthInput"
            },
            "maxItems": 12,
            "minItems": 12,
            "title": "Consumption",
            "type": "array"
          },
          "filters": {
            "$ref": "#/components/schemas/CompareFilters"
          },
          "istat_comune": {
            "anyOf": [
              {
                "pattern": "^\\d{6}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "6-digit ISTAT comune code; needed to see area-restricted offers.",
            "title": "Istat Comune"
          },
          "offset": {
            "default": 0,
            "description": "Matching results to skip (pagination).",
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "residency": {
            "default": "resident",
            "enum": [
              "resident",
              "non_resident"
            ],
            "title": "Residency",
            "type": "string"
          },
          "scenario": {
            "discriminator": {
              "mapping": {
                "flat": "#/components/schemas/Flat",
                "historical": "#/components/schemas/Historical",
                "scaled": "#/components/schemas/Scaled"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/Historical"
              },
              {
                "$ref": "#/components/schemas/Scaled"
              },
              {
                "$ref": "#/components/schemas/Flat"
              }
            ],
            "title": "Scenario"
          },
          "search": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Case- and accent-insensitive substring match on supplier or offer name, applied after ranking and filters (ranks unchanged).",
            "title": "Search"
          },
          "top_n": {
            "default": 50,
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Top N",
            "type": "integer"
          }
        },
        "required": [
          "consumption"
        ],
        "title": "CompareRequest",
        "type": "object"
      },
